# The pure-Python `pmg_qt` package with its Qt Designer forms (forms/*.ui).

load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "pmg_qt",
    srcs = glob(["**/*.py"]),
    data = glob(
        ["**/*"],
        exclude = [
            "**/*.py",
            "**/__pycache__/**",
            "BUILD.bazel",
        ],
    ),
    imports = [".."],
    visibility = ["//visibility:public"],
)
