# Starlark helpers and build-time tools for the Bazel build of the wheel.

load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python//python/uv:lock.bzl", "lock")
load(":shader_gen.bzl", "pymol_generated_headers")

py_binary(
    name = "generate_headers",
    srcs = ["generate_headers_main.py"],
    main = "generate_headers_main.py",
    deps = ["//scripts/python:create_generated_files_lib"],
)

# ShaderText.h/.cpp and PyMOLBuildInfo.h, which //:_cmd.so compiles in.
pymol_generated_headers(
    name = "pymol_generated_headers",
    shader_srcs = ["//data/shaders:shader_srcs"],
    visibility = ["//visibility:public"],
)

# The action tool of :wheel_merge.bzl, and the library its test imports.
py_library(
    name = "merge_wheel_files_lib",
    srcs = ["merge_wheel_files.py"],
    imports = ["."],
    visibility = ["//tools/bazel/tests:__pkg__"],
)

py_binary(
    name = "merge_wheel_files",
    srcs = ["merge_wheel_files.py"],
)

exports_files(["requirements_lock.txt"])

# Locks requirements.in into requirements_lock.txt for every supported Python,
# with the uv binary rules_python fetches. Tagged manual, as it needs the
# network; update the lock with `bazel run //tools/bazel:requirements.update`.
lock(
    name = "requirements",
    srcs = ["requirements.in"],
    out = "requirements_lock.txt",
    args = [
        "--universal",
        "--python-version",
        "3.10",
    ],
)
