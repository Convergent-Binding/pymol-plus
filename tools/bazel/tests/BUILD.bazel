load("@rules_python//python:defs.bzl", "py_test")

# Holds //tools/bazel:pyproject.bzl's Starlark reading of pyproject.toml to
# CPython's tomllib. Pinned to 3.12 because tomllib needs 3.11 and the
# default toolchain is the 3.10 floor.
py_test(
    name = "pyproject_metadata_test",
    size = "small",
    srcs = ["pyproject_metadata_test.py"],
    args = [
        "$(rootpath @pymol_project_metadata//:metadata.json)",
        "$(rootpath //:pyproject.toml)",
    ],
    data = [
        "//:pyproject.toml",
        "@pymol_project_metadata//:metadata.json",
    ],
    python_version = "3.12",
)

# create_buildinfo() writes the SHA and date its caller gives without running
# git (the Bazel action passes both).
py_test(
    name = "create_buildinfo_test",
    size = "small",
    srcs = ["create_buildinfo_test.py"],
    deps = ["//scripts/python:create_generated_files_lib"],
)

# The shader cache and build info the _cmd extension compiles in.
py_test(
    name = "generated_headers_test",
    size = "small",
    srcs = ["generated_headers_test.py"],
    args = [
        "\"$(rootpaths //tools/bazel:pymol_generated_headers)\"",
        "\"$(rootpaths //data/shaders:shader_srcs)\"",
    ],
    data = [
        "//data/shaders:shader_srcs",
        "//tools/bazel:pymol_generated_headers",
    ],
)
