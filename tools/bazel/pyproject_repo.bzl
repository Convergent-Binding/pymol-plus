"""Expose pyproject.toml's `[project]` metadata to BUILD files.

`py_wheel`'s metadata attributes are ordinary string attributes, so their
values have to exist at loading time; a build action that reads pyproject.toml
would be too late. Only a repository rule can read a file at loading time, so
this rule reads it, parses it with //tools/bazel:pyproject.bzl and writes a .bzl
of plain constants that BUILD files load normally. It also writes the same
constants as metadata.json, which //tools/bazel/tests:pyproject_metadata_test
holds to CPython's tomllib.

`rctx.path(...)` is called before reading so Bazel records the dependency and
refetches when pyproject.toml changes.

No interpreter is involved: the parsing is Starlark, so the build depends on
nothing it did not fetch itself.
"""

load("//tools/bazel:pyproject.bzl", "parse_project_table", "require")

def _render(value):
    if type(value) == "list":
        return "[" + ", ".join(['"{}"'.format(v) for v in value]) + "]"
    return '"{}"'.format(value)

def _pyproject_metadata_impl(rctx):
    # Registers the dependency so an edit to pyproject.toml refetches this.
    path = rctx.path(rctx.attr.src)
    values = parse_project_table(rctx.read(path), str(rctx.attr.src))

    constants = {
        "NAME": require(values, "name"),
        "VERSION": require(values, "version"),
        # pyproject.toml has its description commented out, so this one key is
        # optional; an empty summary is what the wheel declared before Bazel.
        "DESCRIPTION": values.get("description") or "",
        "REQUIRES_PYTHON": require(values, "requires-python"),
        "DEPENDENCIES": require(values, "dependencies"),
    }

    lines = [
        "# Generated by //tools/bazel:pyproject_repo.bzl from pyproject.toml.",
        "# Do not edit. Change pyproject.toml instead.",
        "",
    ] + ["{} = {}".format(k, _render(v)) for k, v in constants.items()] + [""]
    rctx.file("BUILD.bazel", 'exports_files(["metadata.json"])\n')
    rctx.file("metadata.bzl", "\n".join(lines))
    rctx.file("metadata.json", json.encode_indent(constants) + "\n")

pyproject_metadata = repository_rule(
    implementation = _pyproject_metadata_impl,
    attrs = {
        "src": attr.label(
            allow_single_file = True,
            default = "//:pyproject.toml",
        ),
    },
    doc = "Reads pyproject.toml's [project] table into loadable Starlark constants.",
)

def _extension_impl(_module_ctx):
    pyproject_metadata(name = "pymol_project_metadata")

pyproject = module_extension(implementation = _extension_impl)
