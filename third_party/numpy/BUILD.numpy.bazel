# BUILD file for the @numpy_headers_* external repositories (see MODULE.bazel).
#
# Only the NumPy C-API headers are needed (os_numpy.h's
# `#include <numpy/arrayobject.h>`): _cmd never links against NumPy, it loads
# the C-API function table at run time through `import_array()`. The headers
# come from a prebuilt wheel because _numpyconfig.h is generated by NumPy's own
# build; a wheel already holds the generated file. BSD-3-Clause.

load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "headers",
    hdrs = glob(["numpy/_core/include/numpy/**"]),
    includes = ["numpy/_core/include"],
    visibility = ["//visibility:public"],
)
