# Upstream PyMOL files with marked edits ("BEGIN EDITED CODE SEGMENT") that
# replace the originals in the app bundle, and startup_wrapper.py, the app's
# entry module.

load("@rules_python//python:defs.bzl", "py_test")

exports_files(
    glob(
        ["**/*.py"],
        exclude = ["*_test.py"],
    ),
    visibility = ["//distribution:__subpackages__"],
)

filegroup(
    name = "overlays",
    srcs = glob(
        ["**/*.py"],
        exclude = ["*_test.py"],
    ),
    visibility = ["//distribution:__subpackages__"],
)

# startup_wrapper.py turns the app's --new-gui and --classic-gui into
# PYMOL_PLUS_GUI and keeps them from PyMOL.
py_test(
    name = "startup_wrapper_test",
    size = "small",
    srcs = ["startup_wrapper_test.py"],
    data = ["pymol/startup_wrapper.py"],
    legacy_create_init = False,
    python_version = "3.13",
)

# Fails when a modules/ original changes after its copy here was made.
py_test(
    name = "edited_base_test",
    size = "small",
    srcs = ["//distribution/bundle:tests/edited_base_test.py"],
    data = [
        "upstream.sha256",
        ":overlays",
        "//modules/pmg_qt",
    ],
    # The test lists edited/pmg_qt/*.py; no generated __init__.py there.
    legacy_create_init = False,
    main = "//distribution/bundle:tests/edited_base_test.py",
)
